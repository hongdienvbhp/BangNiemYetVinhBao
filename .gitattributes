# === Git LFS: chỉ file nhị phân (không diff được) ===
# Cài: https://git-lfs.com  →  git lfs install

# Ảnh dùng trực tiếp trên website giữ trong Git thường để deploy tĩnh không phụ thuộc Git LFS.
# Các đuôi ảnh vẫn được đánh dấu binary ở cuối file để Git không cố diff nội dung.

# Office / bảng tính nguồn
*.xlsx filter=lfs diff=lfs merge=lfs -text
*.xls filter=lfs diff=lfs merge=lfs -text
*.docx filter=lfs diff=lfs merge=lfs -text
*.pdf filter=lfs diff=lfs merge=lfs -text

# Gói nén
*.zip filter=lfs diff=lfs merge=lfs -text
*.7z filter=lfs diff=lfs merge=lfs -text
*.tar.gz filter=lfs diff=lfs merge=lfs -text

# === Text: giữ Git thường (cần diff / review) ===
# js/*.js, data/*.json, css/*.css, *.html, *.csv, *.svg, *.md và ảnh web
# KHÔNG đưa các asset runtime nhỏ vào LFS — cần clone/deploy được trực tiếp.

# Chuẩn hóa xuống dòng
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary rõ ràng (kể cả khi chưa LFS)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.xlsx binary
*.xls binary
*.pdf binary
*.zip binary
